<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">
    <changeSet id="003-1" author="bivan">
        <createTable tableName="statement">
            <column name="statement_id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_statement"/>
            </column>
            <column name="client_id" type="UUID"/>
            <column name="credit_id" type="UUID"/>
            <column name="application_status" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="creation_date" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="applied_offer" type="jsonb"/>
            <column name="ses_code" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="status_history" type="jsonb">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>